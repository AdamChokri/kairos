# frontend/.npmrc - read by npm when it runs in this folder (plan WP4.6, decision D-12).
# `npm install <package>` and `npm update` pick only versions published at least 7 days ago, the same rule as the
# Dependabot cooldown, the age check of ci/tools/lock-age.py and the tools of P3. Needs npm 11.10 or newer: the npm
# of the pinned Node image (ci/tools/node-image.txt) is checked by the step that added this file. `npm ci`, which
# installs exactly what package-lock.json says, is not affected: the lock-age check covers the lockfile itself.
min-release-age=7
