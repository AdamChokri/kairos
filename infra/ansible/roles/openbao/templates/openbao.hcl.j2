# /etc/openbao/openbao.hcl - managed by Ansible (infra/ansible/roles/openbao), plan WP1.3.
ui = true

# Integrated storage: mlock is not recommended with Raft, and the packaged unit grants no
# CAP_IPC_LOCK; the unit sets MemorySwapMax=0, so secrets are not swapped out either.
disable_mlock = true

api_addr     = "https://openbao.kairos.lab:8200"
cluster_addr = "https://openbao.kairos.lab:8201"

storage "raft" {
  path    = "/opt/openbao/data"
  node_id = "{{ inventory_hostname }}"
}

listener "tcp" {
  address         = "0.0.0.0:8200"
  cluster_address = "0.0.0.0:8201"
  tls_cert_file   = "/opt/openbao/tls/tls.crt"
  tls_key_file    = "/opt/openbao/tls/tls.key"
  tls_min_version = "tls12"
}

# OpenBao 2.7 accepts audit devices from its configuration only, not through the API.
audit "file" "file" {
  description = "Kairos audit log (shipped to Wazuh in P6)"
  options {
    file_path = "/var/log/openbao/audit.log"
    mode      = "0640"
  }
}
