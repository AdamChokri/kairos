# security/policy/gates.env - thresholds and rollout modes for every control (decision D-11).
# Sourced by ci/scripts/*.sh (through ci/scripts/lib.sh) and changed only through pull requests.
# Modes: report (findings turn only the stage yellow, the build stays green) -> enforce (findings fail the build).
# Every control starts in report mode (WP4.2); WP4.5 switches each to enforce in its own pull request,
# once its findings are fixed or covered by an exception (WP4.4). Tests (build_test) always enforce.

MODE_PREFLIGHT=enforce
MODE_SECRETS=report
MODE_SAST=report
MODE_SCA=report
MODE_IAC=report
MODE_IMAGE=report

# SAST
SEMGREP_BLOCK_SEVERITY=ERROR
BANDIT_BLOCK_SEVERITY=HIGH
BANDIT_MIN_CONFIDENCE=MEDIUM
ESLINT_BLOCK_LEVEL=error
SONAR_GATE="Kairos Secure"      # main lane only (D-09); waited for with sonar.qualitygate.wait=true
SONAR_PROJECT_KEY=kairos
SONAR_HOST_URL=http://sonar.kairos.lab:9000
# The version SonarQube's "Previous version" new-code period counts from (NC-01, D-32): never change it
# unless a new reporting period must start, and say so in the pull request.
SONAR_PROJECT_VERSION=0.2.0

# Dependencies and images (Trivy)
TRIVY_BLOCK_ALWAYS=CRITICAL
TRIVY_BLOCK_IF_FIXED=HIGH
TRIVY_IMAGE_BLOCK_SECRETS=true
TRIVY_BLOCK_KEV=true             # any CVE in the CISA KEV catalog blocks, whatever its severity (section 4.1)
KEV_MAX_AGE_DAYS=7               # a cached feed is accepted when CISA is unreachable; an older one is a tool error

# Dockerfiles
HADOLINT_BLOCK_LEVEL=error
TRIVY_CONFIG_BLOCK=HIGH,CRITICAL

# DAST (P5): rule levels live in security/policy/zap/rules.tsv and rules-api.tsv (FAIL blocks)

# Exceptions (maximum days per severity; warning window)
EXC_MAX_DAYS_CRITICAL=7
EXC_MAX_DAYS_HIGH=30
EXC_MAX_DAYS_MEDIUM=90
EXC_MAX_DAYS_LOW=180
EXC_WARN_BEFORE_DAYS=7
