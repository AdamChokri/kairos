# /etc/logrotate.d/openbao - managed by Ansible (infra/ansible/roles/openbao).
# SIGHUP (systemctl reload) makes OpenBao reopen its audit file after rotation.
/var/log/openbao/audit.log {
    daily
    rotate 14
    maxsize 100M
    compress
    delaycompress
    missingok
    notifempty
    create 0640 openbao openbao
    postrotate
        systemctl reload openbao >/dev/null 2>&1 || true
    endscript
}
