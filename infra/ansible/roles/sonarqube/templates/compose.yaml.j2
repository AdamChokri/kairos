# /opt/sonarqube/compose.yaml - managed by Ansible (infra/ansible/roles/sonarqube), plan WP1.5.
# Heaps (role defaults): web, compute engine and search engine, sized for the 4 GB VM.
services:
  sonarqube:
    image: "{{ image_sonarqube }}"
    restart: unless-stopped
    depends_on:
      - db
    ports:
      - "9000:9000"
    environment:
      SONAR_JDBC_URL: jdbc:postgresql://db:5432/sonar
      SONAR_JDBC_USERNAME: sonar
      SONAR_WEB_JAVAOPTS: "-Xms128m -Xmx{{ sonarqube_heap_web }}"
      SONAR_CE_JAVAOPTS: "-Xms128m -Xmx{{ sonarqube_heap_ce }}"
      SONAR_SEARCH_JAVAOPTS: "-Xms{{ sonarqube_heap_search }} -Xmx{{ sonarqube_heap_search }}"
    env_file:
      - db.env
    ulimits:
      nofile:
        soft: 131072
        hard: 131072
      nproc:
        soft: 8192
        hard: 8192
    volumes:
      - sonarqube_data:/opt/sonarqube/data
      - sonarqube_logs:/opt/sonarqube/logs
      - sonarqube_extensions:/opt/sonarqube/extensions

  db:
    image: "{{ image_sonarqube_postgres }}"
    restart: unless-stopped
    environment:
      POSTGRES_USER: sonar
      POSTGRES_DB: sonar
    env_file:
      - db.env
    volumes:
      - postgresql_data:/var/lib/postgresql/data

volumes:
  sonarqube_data:
  sonarqube_logs:
  sonarqube_extensions:
  postgresql_data:
